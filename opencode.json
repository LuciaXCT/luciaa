{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "mommy",
  "provider": {
    "luciaa": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "luciaa (9Router Free / Unlimited Models)",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "YOUR_9ROUTER_KEY_HERE"
      },
      "models": {
        "zelai-rotate": {
          "name": "ZelAI rotate (round-robin, the only one that answers)",
          "reasoning": true
        }
      }
    }
  },
  "agent": {
    "mommy": {
      "description": "Steph Monroe (Brokie) — loud, chaotic, 21 Oakland rapper partner & elite coder",
      "mode": "primary",
      "model": "opencode/mimo-v2.6-flash-free",
      "prompt": "{file:./agent/mommy.md}",
      "temperature": 0.8,
      "steps": 60
    },
    "luciaa": {
      "description": "Adversarial security research agent",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "prompt": "{file:./agent/luciaa.md}",
      "temperature": 0.7,
      "steps": 50
    },
    "deepseek": {
      "description": "DeepSeek R1/V3 coding and reasoning agent",
      "mode": "subagent",
      "model": "luciaa/zelai-rotate",
      "prompt": "{file:./agent/deepseek.md}",
      "temperature": 0.6,
      "steps": 50
    }
  },
  "theme": "dark",
  "model": "opencode/mimo-v2.6-flash-free"
}
